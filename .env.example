# DevSentinel AI — configuration (ADR-010: one codebase, role by APP_ROLE).
# Copy to .env and fill in. Everything comes from the environment; nothing is
# read from local disk. Values are validated at startup with secret-free errors.
#
# ROLES
#   APP_ROLE=web     Next.js UI + API + webhook endpoint. Never runs the worker.
#   APP_ROLE=worker  background worker only (queue, TestSprite CLI runs,
#                    monitoring checks, notifications, retention). No inbound port.
#   APP_ROLE=all     both in one process — single-container hosts and local dev only.
#
# A variable is listed under every role that must set it. ENCRYPTION_KEY and
# DATABASE_URL MUST BE IDENTICAL on web and worker (the worker decrypts what
# the web stored). Restart the process after changing any variable unless the
# description says otherwise.

# ============================================================================
# BOTH ROLES (web and worker — keep the values identical)
# ============================================================================

# Role of this process: web | worker | all. Restart: required.
APP_ROLE=all

# PostgreSQL connection string. On pooler platforms (e.g. Vercel) DATABASE_URL
# is the POOLED url the app queries with; see DIRECT_URL below. Self-hosted
# without a pooler: set both to the same URL. Obtain from your Postgres
# provider (Neon/Supabase/RDS/self-hosted). Restart: required.
DATABASE_URL=postgresql://user:password@host:5432/devsentinel

# Direct (non-pooled) connection used ONLY by `prisma migrate deploy` — pooled
# URLs cannot run DDL. Self-hosted without a pooler: same as DATABASE_URL.
# Used by the migrate release step, not by the app. Restart: n/a (migrate only).
DIRECT_URL=postgresql://user:password@host:5432/devsentinel

# 32-byte base64 key encrypting integration credentials (AES-256-GCM).
# Generate: openssl rand -base64 32. Restart: required.
# Rotation: version 1 is ALWAYS read from ENCRYPTION_KEY. To rotate, move the
# NEW key into ENCRYPTION_KEY_V2 and set ENCRYPTION_KEY_VERSION=2, keeping the
# old key in ENCRYPTION_KEY until all stored credentials have been re-saved.
ENCRYPTION_KEY=
# Version marker for key rotation (see above; 1 reads ENCRYPTION_KEY, 2 reads ENCRYPTION_KEY_V2).
ENCRYPTION_KEY_VERSION=1

# Base URL of the WEB deployment — the only public-URL setting. Used in links,
# the documented webhook URL, and password-reset emails; secure cookies and the
# CSRF host check follow the proxy headers automatically. Must be http(s).
# Obtain: your deployment's public URL (a platform subdomain is enough).
# Restart: required.
APP_BASE_URL=http://localhost:3000

# ============================================================================
# WEB ONLY
# ============================================================================

# --- GitHub (webhook processing is disabled until GITHUB_WEBHOOK_SECRET is set) ---
# Create a GitHub App at https://github.com/settings/apps — see
# docs/github-app-setup.md for every permission and why it is needed.
GITHUB_APP_ID=
# PEM private key of the GitHub App (single line with \n escapes).
GITHUB_APP_PRIVATE_KEY=
# Slug of your GitHub App: the last part of https://github.com/apps/<slug>. Enables the
# "Install GitHub App" flow. Set the App's Setup URL to <APP_BASE_URL>/api/github/callback.
GITHUB_APP_SLUG=
# Client id/secret are REQUIRED for "Connect GitHub": they prove which installations each
# signed-in user can access, so accounts never see each other's repositories. Set the App's
# Callback URL to <APP_BASE_URL>/api/github/callback.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Webhook secret configured in the GitHub App settings.
GITHUB_WEBHOOK_SECRET=

# --- Optional integrations (the app reports their status when unset) ---
# Email (optional; when unset, notifications are in-app only).
# EMAIL_PROVIDER: "brevo" (default, free tier of 300 emails/day, no domain needed) or "resend".
# Brevo setup: create a free account at brevo.com, verify your sender address under
# Senders & IP, then create an API key (SMTP & API > API Keys).
EMAIL_PROVIDER=brevo
EMAIL_PROVIDER_API_KEY=
# Verified sender, e.g. DevSentinel <you@example.com> or you@example.com
EMAIL_PROVIDER_FROM=
# AI (optional; when unset, investigations are unavailable)
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
# OpenAI-compatible base URL; defaults to https://api.openai.com/v1
AI_PROVIDER_BASE_URL=

# ============================================================================
# WORKER ONLY
# ============================================================================

# Get an API key from https://www.testsprite.com/dashboard/settings/apikey
# Per-project keys are stored encrypted in the app; TESTSPRITE_API_KEY here is
# only a fallback for worker-side runs when a project has no stored credential.
TESTSPRITE_API_KEY=
# Override the CLI binary location (defaults to node_modules/.bin/testsprite —
# included in the Docker image for worker/all roles).
TESTSPRITE_CLI_PATH=
# Max seconds to wait for a TestSprite run (60–900).
TESTSPRITE_WAIT_TIMEOUT_SECONDS=600

# Poll interval for the job queue in ms (100–600000). Restart: required.
WORKER_POLL_INTERVAL_MS=3000
# Concurrent jobs per worker (1–16). Restart: required.
WORKER_CONCURRENCY=2
# Log/check retention in days (1–3650, default 90), enforced by the worker
# cleanup job. Restart: required (read at each cleanup sweep).
RETENTION_DAYS=90

# ============================================================================
# DEPRECATED (kept for pre-0.2 single-container deployments; prefer APP_ROLE)
# ============================================================================
# WORKER_IN_PROCESS=1 forced the in-process worker when APP_ROLE was unset.
# Use APP_ROLE=all instead. Must be 0 or 1 if set. Restart: required.
WORKER_IN_PROCESS=
